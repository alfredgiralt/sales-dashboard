generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Account {
  id                 String        @id @default(cuid())
  name               String
  category           String
  mainContact        String        @default("")
  contactRole        String        @default("")
  contactEmail       String        @default("")
  contactPhone       String        @default("")
  owner              String        @default("")
  strategicRelevance String        @default("Medium")
  notes              String        @default("")
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  opportunities      Opportunity[]
}

model Opportunity {
  id                   String   @id @default(cuid())
  name                 String
  accountId            String
  account              Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  owner                String   @default("")
  status               String   @default("New lead")
  priority             String   @default("Medium")
  estimatedValue       Float    @default(0)
  probabilityOfClose   Int      @default(0)
  weightedValue        Float    @default(0)
  expectedCloseHorizon String   @default("Unknown")
  opportunityType      String   @default("")
  businessModel        String   @default("")
  strategicRelevance   String   @default("Medium")
  mainContact          String   @default("")
  notes                String   @default("")
  nextStep             String   @default("")
  nextStepDueDate      DateTime?
  lastInteractionDate  DateTime?
  mainRisk             String   @default("")
  riskType             String   @default("")
  riskLevel            String   @default("Low")
  riskDescription      String   @default("")
  mitigationAction     String   @default("")
  blocked              Boolean  @default(false)
  blockerDescription   String   @default("")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}
